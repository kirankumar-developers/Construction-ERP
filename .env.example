# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-1234567890

# MongoDB configuration
MONGO_URI=mongodb://localhost:27017/onsite_service_db

# SMTP Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@onsiteservice.com

# Firebase Cloud Messaging (Optional)
# FIREBASE_CREDENTIALS_JSON=path/to/firebase-credentials.json

# Cloudinary Storage Configuration (Optional)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
